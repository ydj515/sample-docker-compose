# 고정한 PostgreSQL 또는 확장 이미지. 빌드 서비스에서는 기반 이미지입니다.
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f

# 로컬 접속 포트
POSTGRES_PORT=5542

# 새 볼륨 초기화 시 생성할 계정과 DB
POSTGRES_USER=postgres
# .env에 복사한 뒤 실습용 비밀번호를 입력하세요.
POSTGRES_PASSWORD=
POSTGRES_DB=lab

# 컨테이너 시간대 (pg_cron은 예약 시간대에도 적용)
TZ=Asia/Seoul
