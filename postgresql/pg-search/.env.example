# 고정한 PostgreSQL 또는 확장 이미지. 빌드 서비스에서는 기반 이미지입니다.
POSTGRES_IMAGE=paradedb/paradedb:0.25.10-pg17@sha256:293e187d9007952ceeed35b3ed7b10ec996566f48795d71fb8cd5a60c5738634

# 로컬 접속 포트
POSTGRES_PORT=5543

# 새 볼륨 초기화 시 생성할 계정과 DB
POSTGRES_USER=postgres
# .env에 복사한 뒤 실습용 비밀번호를 입력하세요.
POSTGRES_PASSWORD=
POSTGRES_DB=lab

# 컨테이너 시간대 (pg_cron은 예약 시간대에도 적용)
TZ=Asia/Seoul
