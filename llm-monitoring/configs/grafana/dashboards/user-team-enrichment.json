          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select  coalesce(m.team, '(unassigned)') as team,  count(*) as total_users,  sum(case when m.is_active then 1 else 0 end) as active_users,  count(distinct m.department) as department_count from codex_user_email_mapping m where ($v$${team:text}$v$ = $v$All$v$ or m.team = $v$${team:text}$v$) group by m.team order by total_users desc;",
