            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select  coalesce(resolved_team, '(unknown)') as team,  tool_name,  count(*) as call_count,  sum(case when tool_success = true then 1 else 0 end) as success_count,  round(100.0 * avg(case when tool_success = true then 1.0 when tool_success = false then 0.0 else null end), 2) as success_rate_pct,  round(avg(tool_duration_ms), 2) as avg_duration_ms from codex_tool_events_enriched where ($__timeFilter(event_time)) and event_name = 'codex.tool_result' and (($v$${team:text}$v$ = $v$All$v$ or resolved_team = $v$${team:text}$v$)) group by resolved_team, tool_name order by team, call_count desc;",
          "refId": "A"
        }
      ],
      "title": "Team별 Tool Usage (Enriched)",
      "type": "table"
    }
