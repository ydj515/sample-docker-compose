          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select  coalesce(resolved_team, '(unknown)') as team,  count(*) as response_count,  sum(input_tokens) as total_input_tokens,  sum(output_tokens) as total_output_tokens,  sum(total_tokens) as total_tokens,  round(avg(total_tokens), 2) as avg_tokens_per_response from codex_usage_events_enriched where ($__timeFilter(event_time)) and (($v$${team:text}$v$ = $v$All$v$ or resolved_team = $v$${team:text}$v$)) group by resolved_team order by total_tokens desc;",
          "refId": "A"
        }
      ],
      "title": "Team별 Token Usage (Enriched)",
      "type": "table"
    },
    {
      "datasource": {
