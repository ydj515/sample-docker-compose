FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client ca-certificates \
    && pip install --no-cache-dir protobuf==6.33.6 opentelemetry-proto==1.41.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

CMD ["python3", "scripts/otlp_ingest_gateway.py"]
